# Copy this file to .env (which is git-ignored) and replace the values before
# running `docker compose up --build`. Never commit the real .env.
#
# SQL Server passwords need 8+ characters with upper case, lower case, a digit
# and a symbol. Avoid ';' (it breaks the connection string) and '$' (Compose
# treats it as variable interpolation).

# SA password for the app's SQL Server container.
DB_SA_PASSWORD=Change_Me_Db_Pass1!

# SA password for the sql-edge container backing the Service Bus emulator.
SERVICEBUS_SQL_PASSWORD=Change_Me_Sb_Pass1!

# JWT signing key: at least 32 characters, random.
JWT_KEY=replace-with-a-long-random-string-of-32-plus-chars

# The emulator accepts only its fixed development key (SAS_KEY_VALUE); against a
# real namespace, put that namespace's connection string here instead.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# Default admin seeded on startup (Development only).
SEED_ADMIN_EMAIL=admin@ecommerce.local
SEED_ADMIN_PASSWORD=Change_Me_Admin1!

# Optional host port overrides.
# API_PORT=8080
# DB_PORT=1433
